# PORT du serveur
PORT=5000

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:fernando@localhost:5433/postgres?schema=public"


# Secret pour JWT (access token et refresh token)
JWT_SECRET="ton_secret_jwt_super_securise"

# Durée des tokens (optionnel, si tu veux personnaliser)
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

